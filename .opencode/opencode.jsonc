{
  "$schema": "https://opencode.ai/config.json",

  // Project-scoped OpenCode config.
  // Merges OVER ~/.config/opencode/opencode.json(c) â€” only keys set here
  // override global. Keys omitted here inherit from global.
  //
  // Keep this file stack-neutral. Anything that depends on the language or
  // framework (formatter, commands, agents) belongs here once the stack is
  // decided, not before.

  "snapshots": true,

  // Keep the file watcher out of build/dependency trees. Without this, installs
  // and rebuilds trigger large bursts of filesystem events.
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "out/**",
      ".next/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "*.pyc",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      "coverage/**",
      "*.log",
      ".DS_Store",
      "Thumbs.db"
    ]
  },

  // Project-level safety rails. These sit on top of the global rules.
  // Ordered: later matching rules win.
  "permissions": [
    // Refuse to touch secrets even if asked directly.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    // Keep the committed template readable so it can be written/extended.
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },

    // Force a human decision before history-destroying git operations.
    { "action": "shell", "resource": "git push --force *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean -*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },

    // Dropping the database is never an implicit step.
    { "action": "shell", "resource": "*DROP DATABASE*", "effect": "ask" },
    { "action": "shell", "resource": "*DROP TABLE*", "effect": "ask" }
  ]
}

