{"nodes": [{"id": "research_02_competitors", "label": "Competitor Analysis: Quran Memorization Apps (Hifz)", "file_type": "document", "source_file": "research/02-competitors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "research_02_competitors_nour", "label": "Nour", "file_type": "concept", "source_file": "research/02-competitors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voice agent for Quran memorization, Arabic-only, Hafs tradition. Differentiation focuses on hesitation-based competence modeling, proactive mutashabihat challenges, and adaptive retention decay modeling.", "_origin": "semantic"}, {"id": "research_02_competitors_hesitation_based_competence_modeling", "label": "Hesitation-based competence modeling", "file_type": "concept", "source_file": "research/02-competitors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No competitor explicitly treats hesitation as a first-class signal for competence modeling. Nour's angle: Track hesitation patterns, not just correctness. A user who hesitates for 5 seconds before correcting is different from one who recites smoothly. This feeds directly into competence model.", "_origin": "semantic"}, {"id": "research_02_competitors_proactive_mutashabihat_challenges", "label": "Proactive mutashabihat challenges", "file_type": "concept", "source_file": "research/02-competitors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No app described as 'when your recitation of X is clean, challenge you with parallel verse Y that often confuses students'. Nour's angle: After clean recitation, intelligently surface mutashabihat that are commonly confused.", "_origin": "semantic"}, {"id": "research_02_competitors_adaptive_retention_decay_modeling", "label": "Retention decay modeling adaptive to fluency/hesitation", "file_type": "concept", "source_file": "research/02-competitors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Competitors use standard SRS (correctness/time-based). Nour's angle: Competence model that decays based on multiple signals (hesitation, errors, time since last successful fluent recall).", "_origin": "semantic"}, {"id": "research_02_competitors_tarteel_ai", "label": "Tarteel AI", "file_type": "concept", "source_file": "research/02-competitors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Market leader with 15+ million users, real-time AI mistake detection. Has user feedback requesting 5-second timeout for failed recall, indicating interest in hesitation handling.", "_origin": "semantic"}], "edges": [{"source": "research_02_competitors", "target": "research_02_competitors_nour", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/02-competitors.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "research_02_competitors", "target": "research_02_competitors_hesitation_based_competence_modeling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/02-competitors.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "research_02_competitors", "target": "research_02_competitors_proactive_mutashabihat_challenges", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "research/02-competitors.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "research_02_competitors", "target": "research_02_competitors_adaptive_retention_decay_modeling", "relation": "references", "confidence": "EXTRACT